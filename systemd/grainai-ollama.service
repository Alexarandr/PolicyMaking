[Unit]
Description=GrainAI OLLAMA Language Model Service
Documentation=https://github.com/Alexarandr/PolicyMaking
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grainai
Group=grainai
WorkingDirectory=/opt/grainai/ollama
ExecStart=/usr/bin/ollama serve --host 0.0.0.0 --port 11434
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grainai-ollama

# Resource limits
MemoryLimit=8G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
